// Prisma schema for the checkout system.
// See docs/checkout-system-plan.md for the data model rationale.

generator client {
  provider = "prisma-client"
  output   = "../src/lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum CheckoutPageType {
  normal
  sales

  @@map("checkout_page_type")
}

enum BillingInterval {
  monthly
  annually
  none

  @@map("billing_interval")
}

enum CheckoutPageStatus {
  draft
  live
  archived

  @@map("checkout_page_status")
}

enum DiscountType {
  percent
  fixed

  @@map("discount_type")
}

enum PromoAppliesTo {
  device
  monthly
  annual
  device_monthly
  device_annual
  monthly_annual
  all

  @@map("promo_applies_to")
}

enum DiscountMode {
  single
  split

  @@map("discount_mode")
}

enum OrderStatus {
  pending
  paid
  failed

  @@map("order_status")
}

// admin: full access. editor: can only manage checkout pages and add-ons —
// no orders (so no card data), no promo codes, no settings, no admin users.
enum AdminRole {
  admin
  editor

  @@map("admin_role")
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

model AdminUser {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  role         AdminRole @default(admin)
  createdAt    DateTime @default(now()) @map("created_at")

  createdCheckoutPages CheckoutPage[]
  cardAccessLogs       CardAccessAuditLog[]
  checkoutPageLogs     CheckoutPageLog[]

  @@map("admin_users")
}

model Skin {
  id        String   @id @default(uuid()) @db.Uuid
  slug      String   @unique
  name      String
  // color tokens, fonts, layout variant, etc.
  config    Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")

  checkoutPages CheckoutPage[]

  @@map("skins")
}

model CheckoutPage {
  id   String           @id @default(uuid()) @db.Uuid
  slug String           @unique
  type CheckoutPageType @default(normal)

  title       String
  productName String? @map("product_name")
  skinId      String  @map("skin_id") @db.Uuid
  skin   Skin   @relation(fields: [skinId], references: [id])

  // Zoho product mapping (requirement: admin adds Zoho ids per checkout)
  zohoItemId           String? @map("zoho_item_id")
  zohoRecurringItemId  String? @map("zoho_recurring_item_id")

  basePriceCents      Int             @map("base_price_cents")
  recurringPriceCents Int?            @map("recurring_price_cents")
  billingInterval     BillingInterval @default(none) @map("billing_interval")

  // Hero/marketing content for the checkout page itself — distinct from
  // `title` (used internally: admin lists, Zoho, emails). Falls back to
  // `title` when not set. "Waived setup fee" line only renders when
  // originalPriceCents is set (the struck-through "was" price); "today"/
  // "/month" lines are derived from basePriceCents/recurringPriceCents
  // above, not duplicated here.
  headline           String? @map("headline")
  originalPriceCents Int?    @map("original_price_cents")
  // Device/product mockup image shown in the page footer. Path under
  // /public, e.g. "/pages_Images/3-Beginners-Device.png".
  mockupImageUrl     String? @map("mockup_image_url")

  // Rich-text (HTML, admin-designed via the editor toolbar) hero block —
  // headline + waived-fee/price lines as ONE freeform editable block.
  // Takes over the entire hero display when set; falls back to the
  // headline/originalPriceCents-driven block above for pages that predate
  // this field.
  heroHtml String? @map("hero_html")
  // Optional mobile-specific override of heroHtml — lets the admin arrange
  // the same hero content differently (or more compactly) on small screens.
  // Falls back to heroHtml on mobile too when not set.
  heroHtmlMobile String? @map("hero_html_mobile")

  // Optional upgrade offer — a higher-tier product presented at checkout
  // that REPLACES the main product if the customer opts in (unlike add-ons,
  // which stack on top). Presence is keyed off upgradeTitle +
  // upgradePriceCents both being set; leave both null for no upgrade offer.
  upgradeTitle                String? @map("upgrade_title")
  upgradeDescription          String? @map("upgrade_description")
  upgradePriceCents           Int?    @map("upgrade_price_cents")
  upgradeRecurringPriceCents  Int?    @map("upgrade_recurring_price_cents")
  upgradeZohoItemId           String? @map("upgrade_zoho_item_id")
  upgradeZohoRecurringItemId  String? @map("upgrade_zoho_recurring_item_id")

  showPromoCode Boolean @default(false) @map("show_promo_code")

  successRedirectUrl String @map("success_redirect_url")
  failRedirectUrl    String @map("fail_redirect_url")

  // optional marketing webhook (legacy sendDataToWebhook), off by default
  webhookUrl String? @map("webhook_url")

  status CheckoutPageStatus @default(draft)

  createdById String?    @map("created_by") @db.Uuid
  createdBy   AdminUser? @relation(fields: [createdById], references: [id])
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  tieredPlansEnabled Boolean @default(false) @map("tiered_plans_enabled")

  addonLinks      CheckoutPageAddon[]
  promoCodes      PromoCode[]
  orders          Order[]
  priceTiers      PriceTier[]
  billingPlans    BillingPlan[]
  planTiers       PlanTier[]
  logs            CheckoutPageLog[]
  promotionLinks  PromotionCheckoutPage[]

  @@map("checkout_pages")
}

// Quantity-based pricing tiers per checkout page — e.g. 1-4 = $149,
// 5-9 = $139, 10+ = $129. Each tier can have its own Zoho item ID.
// The checkout form picks the tier matching the customer's quantity.
model PriceTier {
  id             String       @id @default(uuid()) @db.Uuid
  checkoutPageId String       @map("checkout_page_id") @db.Uuid
  checkoutPage   CheckoutPage @relation(fields: [checkoutPageId], references: [id], onDelete: Cascade)
  minQty         Int          @map("min_qty")
  maxQty         Int?         @map("max_qty")
  priceCents     Int          @map("price_cents")
  zohoItemId     String?      @map("zoho_item_id")
  isBase         Boolean      @default(false) @map("is_base")
  sortOrder      Int          @default(0) @map("sort_order")

  promotions Promotion[]

  @@map("price_tiers")
}

// Billing cycle options per checkout page — e.g. Monthly $24/mo,
// Annual $249/yr. Admin-configurable per page.
model BillingPlan {
  id             String          @id @default(uuid()) @db.Uuid
  checkoutPageId String          @map("checkout_page_id") @db.Uuid
  checkoutPage   CheckoutPage    @relation(fields: [checkoutPageId], references: [id], onDelete: Cascade)
  interval       BillingInterval
  label          String
  priceCents       Int             @map("price_cents")
  zohoItemId       String?         @map("zoho_item_id")
  chargeAtCheckout Boolean         @default(false) @map("charge_at_checkout")
  isDefault        Boolean         @default(false) @map("is_default")
  sortOrder        Int             @default(0) @map("sort_order")

  @@map("billing_plans")
}

// Named plan tiers per checkout page — e.g. GOLD, PLATINUM, DIAMOND.
// Each tier has qty-based monthly pricing; annual = monthly × 12 minus
// annualDiscountPercent. Only active when CheckoutPage.tieredPlansEnabled.
model PlanTier {
  id                    String       @id @default(uuid()) @db.Uuid
  checkoutPageId        String       @map("checkout_page_id") @db.Uuid
  checkoutPage          CheckoutPage @relation(fields: [checkoutPageId], references: [id], onDelete: Cascade)
  name                  String
  annualDiscountPercent Int          @default(0) @map("annual_discount_percent")
  zohoMonthlyItemId     String?      @map("zoho_monthly_item_id")
  zohoAnnualItemId      String?      @map("zoho_annual_item_id")
  chargeAtCheckout      Boolean      @default(false) @map("charge_at_checkout")
  isDefault             Boolean      @default(false) @map("is_default")
  sortOrder             Int          @default(0) @map("sort_order")

  prices PlanTierPrice[]
  orders Order[]

  @@map("plan_tiers")
}

// Qty-based monthly price rows for a plan tier.
model PlanTierPrice {
  id                String   @id @default(uuid()) @db.Uuid
  planTierId        String   @map("plan_tier_id") @db.Uuid
  planTier          PlanTier @relation(fields: [planTierId], references: [id], onDelete: Cascade)
  minQty            Int      @map("min_qty")
  maxQty            Int?     @map("max_qty")
  monthlyPriceCents Int      @map("monthly_price_cents")
  sortOrder         Int      @default(0) @map("sort_order")

  @@map("plan_tier_prices")
}

// Audit log for checkout page changes — who did what and when.
model CheckoutPageLog {
  id             String        @id @default(uuid()) @db.Uuid
  checkoutPageId String        @map("checkout_page_id") @db.Uuid
  checkoutPage   CheckoutPage  @relation(fields: [checkoutPageId], references: [id], onDelete: Cascade)
  adminUserId    String?       @map("admin_user_id") @db.Uuid
  adminUser      AdminUser?    @relation(fields: [adminUserId], references: [id])
  action         String
  message        String?
  createdAt      DateTime      @default(now()) @map("created_at")

  @@map("checkout_page_logs")
}

// Global, reusable add-on pool — managed in its own admin UI and attached to
// any checkout page (normal or sales) via CheckoutPageAddon, not owned by a
// single page.
model Addon {
  id                 String   @id @default(uuid()) @db.Uuid
  name               String
  description        String?
  imageUrl           String?  @map("image_url")
  priceCents         Int      @map("price_cents")
  // Optional "was" price, shown struck through next to priceCents (e.g.
  // "$199 Now Only $99"), same pattern as CheckoutPage.originalPriceCents.
  originalPriceCents Int?     @map("original_price_cents")
  zohoItemId         String?  @map("zoho_item_id")
  isActive           Boolean  @default(true) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at")

  checkoutPageLinks CheckoutPageAddon[]
  orderAddons       OrderAddon[]

  @@map("addons")
}

// Join table: which addons appear on a given checkout page, and in what
// order (sortOrder controls display order on the checkout page and in the
// admin arrangement UI).
model CheckoutPageAddon {
  id             String       @id @default(uuid()) @db.Uuid
  checkoutPageId String       @map("checkout_page_id") @db.Uuid
  checkoutPage   CheckoutPage @relation(fields: [checkoutPageId], references: [id], onDelete: Cascade)
  addonId        String       @map("addon_id") @db.Uuid
  addon          Addon        @relation(fields: [addonId], references: [id], onDelete: Cascade)
  sortOrder      Int          @default(0) @map("sort_order")

  @@unique([checkoutPageId, addonId])
  @@map("checkout_page_addons")
}

model PromoCode {
  id            String       @id @default(uuid()) @db.Uuid
  code          String       @unique
  discountType  DiscountType  @map("discount_type")
  // percent: 1-100. fixed: cents.
  discountValue Int           @map("discount_value")
  appliesTo     PromoAppliesTo @default(device) @map("applies_to")

  discountMode          DiscountMode   @default(single) @map("discount_mode")
  // Split-mode fields (null when mode = single)
  deviceDiscountType    DiscountType?  @map("device_discount_type")
  deviceDiscountValue   Int?           @map("device_discount_value")
  monthlyDiscountType   DiscountType?  @map("monthly_discount_type")
  monthlyDiscountValue  Int?           @map("monthly_discount_value")
  annualDiscountType    DiscountType?  @map("annual_discount_type")
  annualDiscountValue   Int?           @map("annual_discount_value")

  perDevice             Boolean        @default(false) @map("per_device")

  appliesToCheckoutPageId String?       @map("applies_to_checkout_page_id") @db.Uuid
  appliesToCheckoutPage   CheckoutPage? @relation(fields: [appliesToCheckoutPageId], references: [id], onDelete: Cascade)

  maxRedemptions Int?      @map("max_redemptions")
  timesRedeemed  Int       @default(0) @map("times_redeemed")
  startsAt       DateTime? @map("starts_at")
  expiresAt      DateTime? @map("expires_at")
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at")

  orders     Order[]
  promotions Promotion[]

  @@map("promo_codes")
}

model Order {
  id             String       @id @default(uuid()) @db.Uuid
  checkoutPageId String       @map("checkout_page_id") @db.Uuid
  checkoutPage   CheckoutPage @relation(fields: [checkoutPageId], references: [id])

  promoCodeId String?    @map("promo_code_id") @db.Uuid
  promoCode   PromoCode? @relation(fields: [promoCodeId], references: [id])

  promotionId String?    @map("promotion_id") @db.Uuid
  promotion   Promotion? @relation(fields: [promotionId], references: [id])

  firstName String @map("first_name")
  lastName  String @map("last_name")
  email     String
  phone     String

  // Full checkout-page URL the customer actually landed on, query string
  // included (e.g. "?utm_source=email&utm_campaign=..."), captured at order
  // init (step 1). Lets support/marketing trace which channel — email link,
  // ad, direct, etc. — an order came from.
  landingUrl String? @map("landing_url")

  // Request metadata captured at order init (step 1), same source as
  // landingUrl — client-reported, not verified, for support/fraud triage.
  userAgent String? @map("user_agent")
  ipAddress String? @map("ip_address")

  // Null until step 2 (address/payment) is submitted — the order already
  // exists from step 1 (contact info only) by that point.
  addressLine1 String? @map("address_line1")
  city         String?
  state        String?
  zip          String?
  country      String?

  // Shipping address — same as billing when shippingSameAsBilling is true.
  shippingSameAsBilling Boolean @default(true) @map("shipping_same_as_billing")
  shippingAddressLine1  String? @map("shipping_address_line1")
  shippingCity          String? @map("shipping_city")
  shippingState         String? @map("shipping_state")
  shippingZip           String? @map("shipping_zip")
  shippingCountry       String? @map("shipping_country")

  // Which billing plan the customer selected (monthly/annual).
  selectedBillingPlanId String? @map("selected_billing_plan_id") @db.Uuid

  // Which plan tier (GOLD/PLATINUM/DIAMOND) the customer selected (tiered plans mode).
  selectedPlanTierId String?   @map("selected_plan_tier_id") @db.Uuid
  selectedPlanTier   PlanTier? @relation(fields: [selectedPlanTierId], references: [id])

  cardLast4  String? @map("card_last4")
  cardBrand  String? @map("card_brand")
  // AES-256-CBC + HMAC blobs (hex), same scheme as legacy encrypt()/decrypt().
  // See docs/checkout-system-plan.md §7 for the PCI risk callout on storing these.
  // Null until step 2 for the same reason as the address fields above.
  cardNumberEncrypted String? @map("card_number_encrypted")
  cardCvvEncrypted    String? @map("card_cvv_encrypted")
  // "MM/YYYY", encrypted like the PAN/CVV above.
  cardExpiryEncrypted String? @map("card_expiry_encrypted")
  // Generated at step 1 (order init), independent of card data — an admin
  // must supply this (in addition to being authenticated) to decrypt the
  // card on this order once one exists.
  cardHashKey String @map("card_hash_key")

  quantity              Int     @default(1)
  // Null until step 2 computes a final price (quantity/add-ons/upgrade/promo
  // aren't chosen yet at step 1).
  amountCents           Int?    @map("amount_cents")
  recurringAmountCents  Int?    @map("recurring_amount_cents")
  // Whether the customer opted into the checkout page's upgrade offer —
  // amountCents already reflects whichever price was actually charged;
  // this just records which product line it corresponds to.
  upgradeSelected       Boolean @default(false) @map("upgrade_selected")

  authNetResponseCode  String? @map("auth_net_response_code")
  authNetAuthCode      String? @map("auth_net_auth_code")
  authNetTransactionId String? @map("auth_net_transaction_id")
  authNetMessage       String? @map("auth_net_message")

  status OrderStatus @default(pending)

  // Shipping rate selected at checkout (international only; null = domestic/free)
  shippingRateCents Int?    @map("shipping_rate_cents")
  shippingCarrier   String? @map("shipping_carrier")
  shippingService   String? @map("shipping_service")
  shippingEstDays   Int?    @map("shipping_est_days")
  shippoRateId      String? @map("shippo_rate_id")

  zohoSynced   Boolean @default(false) @map("zoho_synced")
  zohoPayload  Json?   @map("zoho_payload")
  zohoResponse Json?   @map("zoho_response")

  createdAt DateTime @default(now()) @map("created_at")

  orderAddons    OrderAddon[]
  cardAccessLogs CardAccessAuditLog[]
  events         OrderEvent[]

  abandonedNotifiedAt DateTime? @map("abandoned_notified_at")

  @@map("orders")
}

// Chronological activity log for an order — checkout started, payment
// attempted/settled, and each post-payment side effect (Zoho, emails,
// webhook) — so admins can see exactly what happened and when, especially
// for orders that stalled partway through.
model OrderEvent {
  id        String   @id @default(uuid()) @db.Uuid
  orderId   String   @map("order_id") @db.Uuid
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type      String
  message   String?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("order_events")
}

model OrderAddon {
  id         String @id @default(uuid()) @db.Uuid
  orderId    String @map("order_id") @db.Uuid
  order      Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  addonId    String @map("addon_id") @db.Uuid
  addon      Addon  @relation(fields: [addonId], references: [id])
  priceCents Int    @map("price_cents")

  @@map("order_addons")
}

model CardAccessAuditLog {
  id          String    @id @default(uuid()) @db.Uuid
  orderId     String    @map("order_id") @db.Uuid
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  adminUserId String    @map("admin_user_id") @db.Uuid
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id])
  viewedAt    DateTime  @default(now()) @map("viewed_at")
  ipAddress   String?   @map("ip_address")

  @@map("card_access_audit_log")
}

// Limited-time promotion — locks a checkout page to a single price tier
// with an auto-applied promo code, hiding the normal qty/tier selector.
model Promotion {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  isActive    Boolean   @default(false) @map("is_active")
  startsAt    DateTime? @map("starts_at")
  endsAt      DateTime? @map("ends_at")
  badgeText   String    @default("Limited Time") @map("badge_text")
  urgencyText String    @default("Offer ends soon — don't miss out!") @map("urgency_text")
  // IANA timezone the admin used when setting startsAt/endsAt.
  // Dates are stored as UTC; this is kept for display back in admin.
  timezone    String    @default("America/New_York")

  promoCodeId String    @map("promo_code_id") @db.Uuid
  promoCode   PromoCode @relation(fields: [promoCodeId], references: [id])

  priceTierId String    @map("price_tier_id") @db.Uuid
  priceTier   PriceTier @relation(fields: [priceTierId], references: [id])

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  checkoutPages PromotionCheckoutPage[]
  orders        Order[]

  @@map("promotions")
}

// Join table: which checkout pages a promotion applies to.
model PromotionCheckoutPage {
  id             String       @id @default(uuid()) @db.Uuid
  promotionId    String       @map("promotion_id") @db.Uuid
  promotion      Promotion    @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  checkoutPageId String       @map("checkout_page_id") @db.Uuid
  checkoutPage   CheckoutPage @relation(fields: [checkoutPageId], references: [id], onDelete: Cascade)

  @@unique([promotionId, checkoutPageId])
  @@map("promotion_checkout_pages")
}

// Singleton settings row (admin-editable, replaces the old env-var-only
// SendGrid config) — the app always operates on whichever row comes back
// first; the admin settings page never creates a second one.
model EmailSettings {
  id                           String   @id @default(uuid()) @db.Uuid
  sendgridApiKey               String?  @map("sendgrid_api_key")
  emailFrom                    String   @map("email_from")
  internalNotifyEmails         String[] @map("internal_notify_emails")
  customerConfirmationEnabled  Boolean  @default(true) @map("customer_confirmation_enabled")
  customerConfirmationSubject  String   @map("customer_confirmation_subject")
  customerConfirmationHtml     String   @map("customer_confirmation_html")
  internalNotifySubject        String   @map("internal_notify_subject")
  internalNotifyHtml           String   @map("internal_notify_html")
  updatedAt                    DateTime @updatedAt @map("updated_at")

  @@map("email_settings")
}

model ShippingSettings {
  id              String   @id @default(uuid()) @db.Uuid
  enabled         Boolean  @default(false)
  warehouseName   String   @map("warehouse_name")
  warehouseStreet String   @map("warehouse_street")
  warehouseCity   String   @map("warehouse_city")
  warehouseState  String   @map("warehouse_state")
  warehouseZip    String   @map("warehouse_zip")
  warehouseCountry String  @map("warehouse_country")
  warehousePhone  String   @map("warehouse_phone")
  maxDevicesPerBox Int     @default(20) @map("max_devices_per_box")
  updatedAt       DateTime @updatedAt @map("updated_at")

  packageTiers    ShippingPackageTier[]
  weightEntries   ShippingWeightEntry[]

  @@map("shipping_settings")
}

model ShippingPackageTier {
  id                String   @id @default(uuid()) @db.Uuid
  shippingSettingsId String  @map("shipping_settings_id") @db.Uuid
  shippingSettings  ShippingSettings @relation(fields: [shippingSettingsId], references: [id], onDelete: Cascade)
  minQty            Int      @map("min_qty")
  maxQty            Int      @map("max_qty")
  label             String
  lengthIn          Decimal  @map("length_in") @db.Decimal(5, 2)
  widthIn           Decimal  @map("width_in") @db.Decimal(5, 2)
  heightIn          Decimal  @map("height_in") @db.Decimal(5, 2)
  maxWeightLb       Decimal  @map("max_weight_lb") @db.Decimal(5, 2)
  sortOrder         Int      @default(0) @map("sort_order")

  @@map("shipping_package_tiers")
}

model ShippingWeightEntry {
  id                String   @id @default(uuid()) @db.Uuid
  shippingSettingsId String  @map("shipping_settings_id") @db.Uuid
  shippingSettings  ShippingSettings @relation(fields: [shippingSettingsId], references: [id], onDelete: Cascade)
  qty               Int
  weightLb          Decimal  @map("weight_lb") @db.Decimal(5, 2)

  @@unique([shippingSettingsId, qty])
  @@map("shipping_weight_entries")
}

model AbandonedCheckoutSettings {
  id              String   @id @default(uuid()) @db.Uuid
  enabled         Boolean  @default(false)
  slackWebhookUrl String?  @map("slack_webhook_url")
  timeoutMinutes  Int      @default(30) @map("timeout_minutes")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("abandoned_checkout_settings")
}
